# Copie para .env e ajuste. Todas as variáveis têm o prefixo TSI_.

# demo = lê só de sample_data/ (offline, sem rede); live = baixa Copernicus DEM (AWS) e SoilGrids (ISRIC)
TSI_MODE=demo

# SQLite local (demo/testes). Com docker-compose o valor é sobrescrito para o PostGIS.
TSI_DATABASE_URL=sqlite:///./data/tsi.db

TSI_DATA_DIR=./data
TSI_SAMPLE_DIR=./sample_data

# Fontes (mude só se usar espelho próprio)
TSI_DEM_BASE_URL=https://copernicus-dem-30m.s3.amazonaws.com
TSI_SOILGRIDS_BASE_URL=https://files.isric.org/soilgrids/latest/data

# Limites de proteção de recursos (não são limites científicos)
TSI_MAX_AREA_HA=20000
TSI_MAX_UPLOAD_MB=20
TSI_JOB_WORKERS=2

TSI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# docker-compose
POSTGRES_USER=tsi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=tsi
